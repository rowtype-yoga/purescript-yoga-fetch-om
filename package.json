{
  "name": "purescript-yoga-fetch-om",
  "version": "0.4.0",
  "description": "Derive type-safe fetch clients from yoga HTTP API definitions",
  "type": "module",
  "scripts": {
    "build": "spago build",
    "test": "spago test",
    "test:compile-fail": "bun compile-fail-tests/run.js",
    "clean": "rm -rf output .spago",
    "watch": "spago build --watch",
    "repl": "spago repl",
    "docs": "spago docs",
    "bundle": "spago bundle-app --main Complete.Example --to dist/index.js"
  },
  "keywords": [
    "purescript",
    "fetch",
    "http",
    "client",
    "api",
    "yoga",
    "type-safe"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.45.1",
    "fastify": "^5.7.4",
    "jose": "^6.2.8",
    "jsdom": "^28.0.0",
    "purescript": "^0.15.15",
    "spago": "^1.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
